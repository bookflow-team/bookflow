
# ==================================
# BookFlow - Environment Example
# ==================================

# PostgreSQL
POSTGRES_DB=bookflow
POSTGRES_USER=bookflow
POSTGRES_PASSWORD=change_me_local
POSTGRES_PORT=5432

# Database connection for tools running outside Compose
DATABASE_URL=postgresql://bookflow:change_me_local@127.0.0.1:5432/bookflow
# Set COMPOSE_DATABASE_URL only to override the URL Compose builds from POSTGRES_*.
# Use the db hostname and URL-encode special characters in credentials.
# COMPOSE_DATABASE_URL=postgresql://bookflow:change_me_local@db:5432/bookflow

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Authentication
SECRET_KEY=replace_with_random_secret
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Frontend
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8000

