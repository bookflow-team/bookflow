
# ==================================
# BookFlow - Environment Example
# ==================================

# PostgreSQL
POSTGRES_DB=bookflow
POSTGRES_USER=bookflow
POSTGRES_PASSWORD=change_me_local
POSTGRES_PORT=5432

# Database connection (Docker)
DATABASE_URL=postgresql://bookflow:change_me_local@127.0.0.1:5432/bookflow

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Authentication
SECRET_KEY=replace_with_random_secret
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Frontend
VITE_API_URL=http://localhost:8000

