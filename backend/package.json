{
  "name": "bookflow-backend",
  "private": true,
  "type": "module",
  "dependencies": {
    "@elysiajs/cors": "^1.4.3",
    "@elysiajs/openapi": "^1.4.17",
    "drizzle-orm": "^0.45.4",
    "elysia": "^1.4.32",
    "postgres": "^4.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@jest/globals": "30",
    "@swc/core": "^1.16.22",
    "@swc/jest": "^0.2.39",
    "@types/bun": "^1.4.4",
    "drizzle-kit": "^0.31.11",
    "jest": "30",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "test": "jest",
    "typecheck": "tsc --noEmit",
